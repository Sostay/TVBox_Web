<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="640dp"
        android:background="#111827"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Status Dot & Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/indicator_running" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TVBox Web 服务运行中"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="在局域网内任意手机、电脑或 iPad 浏览器打开："
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <!-- Address Bar Box -->
        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1F2937"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="http://192.168.1.100:8999"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Active Source Display -->
        <TextView
            android:id="@+id/tvCurrentSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="初始源为空 (请在浏览器网页端添加配置)"
            android:textColor="#818CF8"
            android:textSize="12sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:backgroundTint="#4F46E5"
                android:text="重启服务"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
