# ========================================================
# TVBox Web - Git Attributes (Line Ending Normalization)
# ========================================================

# Ensure Windows batch scripts and PowerShell always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Web assets and source files
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.webmanifest text eol=lf
*.md text eol=lf
*.css text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.apk binary
*.jks binary
*.jar binary
